# ==============================================================================
# BookMyShow Ticket Notifier Bot Configuration
# Copy this file to .env and fill in your values
# ==============================================================================

# BookMyShow Movie URL or Event Code (e.g. from your browser)
# Examples:
#   https://in.bookmyshow.com/movies/mumbai/ramayana/ET00451914
#   https://in.bookmyshow.com/buytickets/ramayana-mumbai/movie-mumbai-ET00451914-MT/20261110
#   ET00451914
BMS_URL=https://in.bookmyshow.com/movies/mumbai/ramayana/ET00451914

# Dates to monitor (optional). Supports:
#   - Empty (checks all bookable and upcoming dates listed on BMS)
#   - today (checks today only)
#   - today+3 (checks today through next 3 days)
#   - Date range: 20261110-20261115 or 2026-11-10 to 2026-11-15
#   - Comma-separated: 20261110,20261111
BMS_DATES=

# Optional Theatre filter (substring match, comma-separated)
# Example: PVR, INOX, Miraj, Cinepolis
BMS_THEATRE=

# Optional Show Type / Format / Language filter (comma-separated)
# Examples:
#   hindi, imax   -> checks all Hindi IMAX shows
#   imax          -> checks IMAX in any language
#   3d            -> checks all 3D shows
#   4dx           -> checks 4DX shows
BMS_SHOW_TYPE=

# Optional Time Period filter (comma-separated)
# Options: morning (6-12), afternoon (12-16), evening (16-19), night (19-24)
BMS_TIME=

# Optional City / Region override (e.g. mumbai, delhi, bengaluru, chennai, hyderabad, pune, etc.)
# If left empty, auto-detected from the BMS_URL
BMS_REGION=

# Continuous monitoring interval in seconds for local bot loop (e.g. 60 = checks every 1 minute)
# Set to 0 to run once and exit
CHECK_INTERVAL=60

# Send an email with current showtimes on startup/first check (true/false)
NOTIFY_ON_START=true

# Always send an email on every check, even when nothing has changed (true/false, default: false)
FORCE_EMAIL=false

# ==============================================================================
# Resend Email Configuration (Optional - for email alerts)
# Get a free API key at https://resend.com
# ==============================================================================
RESEND_API_KEY=
# One or more recipient emails (comma-separated, e.g. you@example.com, friend@example.com)
RESEND_TO_EMAIL=
# Sender email address. Use 'onboarding@resend.dev' for sandbox (testing to your registered email)
# or your own verified domain (e.g. alerts@yourdomain.com) to send to any recipients.
RESEND_FROM_EMAIL=onboarding@resend.dev
